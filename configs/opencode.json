{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "options": {
        "baseURL": "https://hivegpt.cn/v1",
        "apiKey": "{env:HIVEGPT_API_KEY}"
      },
      "models": {
        "gpt-5.5": { "name": "GPT-5.5", "limit": { "context": 1050000, "output": 128000 }, "options": { "store": false } },
        "gpt-6.1-sol": { "name": "GPT-6.1 Sol", "limit": { "context": 1050000, "output": 128000 }, "options": { "store": false } },
        "gpt-6-luna": { "name": "GPT-6 Luna", "limit": { "context": 1050000, "output": 128000 }, "options": { "store": false } }
      }
    }
  },
  "model": "openai/gpt-5.5",
  "small_model": "openai/gpt-6-luna"
}
